{
  "outputDirectory": "../../fastlane/screenshots/en-US",
  "output": { "width": 2064, "height": 2752, "format": "png" },
  "mode": "inset",
  "frameColor": "Space Gray",
  "background": { "colors": ["#0F172A", "#1E40AF"], "angle": 160 },
  "text": {
    "position": "top",
    "title": { "font": "system", "size": 120, "weight": "bold", "color": "#FFFFFF" },
    "subtitle": { "font": "system", "size": 64, "weight": "regular", "color": "#FFFFFFCC" },
    "spacing": 28
  },
  "padding": 120,
  "gap": 80,
  "deviceScale": 1.0,
  "screenshots": [
    {
      "path": "../.build/screenshots/raw/ipad/01-feed.png",
      "output": "ipad-01-feed",
      "title": "Every code. Every secret.",
      "subtitle": "2FA codes and encrypted notes, together."
    },
    {
      "path": "../.build/screenshots/raw/ipad/02-detail.png",
      "output": "ipad-02-detail",
      "title": "Tap. Copy. Done.",
      "subtitle": "Codes ready to paste the moment you need them."
    },
    {
      "path": "../.build/screenshots/raw/ipad/03-tags.png",
      "output": "ipad-03-tags",
      "title": "Tidy by design",
      "subtitle": "Tag items to find them fast."
    },
    {
      "path": "../.build/screenshots/raw/ipad/04-backups.png",
      "output": "ipad-04-backups",
      "title": "Backups you can hold",
      "subtitle": "Print to paper or save an encrypted file."
    },
    {
      "path": "../.build/screenshots/raw/ipad/05-settings.png",
      "output": "ipad-05-settings",
      "title": "Private by default",
      "subtitle": "No account needed. Fully open source."
    },
    {
      "path": "../.build/screenshots/raw/ipad/01-feed-dark.png",
      "output": "ipad-06-feed-dark",
      "title": "Easy on the eyes",
      "subtitle": "Looks right in light and dark."
    }
  ]
}
