{
  "outputDirectory": "../../fastlane/screenshots/en-US",
  "output": { "width": 2064, "height": 2752, "format": "png" },
  "mode": "inset",
  "frameColor": "Silver",
  "background": {
    "colors": ["#020409", "#050B1A", "#0A1A42"],
    "locations": [0, 0.45, 1],
    "angle": 180,
    "glows": [
      { "x": 0.6, "y": 0.7, "radius": 0.8, "color": "#0A84FF8C" },
      { "x": 0.95, "y": 0.06, "radius": 0.45, "color": "#3E7BFA4D" },
      { "x": 0.02, "y": 0.98, "radius": 0.5, "color": "#5E5CE666" }
    ],
    "images": [
      { "path": "assets/vault-door.png", "x": 0.5, "y": 0.15, "width": 1.25, "rotation": -6, "opacity": 0.06 }
    ]
  },
  "text": {
    "position": "top",
    "anchor": "edge",
    "title": { "font": "system", "size": 210, "weight": "bold", "color": "#FFFFFF" },
    "subtitle": { "font": "system", "size": 80, "weight": "regular", "color": "#FFFFFFC7" },
    "spacing": 40,
    "minScale": 0.8,
    "maxScale": 1,
    "maxRotation": 0,
    "accentColor": "#4DA3FF"
  },
  "padding": 150,
  "gap": 96,
  "shadow": { "color": "#000000A6", "radius": 120, "offsetY": 48 },
  "screenshots": [
    {
      "output": "ipad-01-codes",
      "title": "Every code.\nEvery secret.",
      "accent": "secret.",
      "subtitle": "Two-factor codes and private notes,\nkept on your iPad.",
