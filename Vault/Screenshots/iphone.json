{
  "outputDirectory": "../../fastlane/screenshots/en-US",
  "output": { "width": 1320, "height": 2868, "format": "png" },
  "mode": "inset",
  "frameColor": "Silver",
  "background": {
    "colors": ["#020409", "#050B1A", "#0A1A42"],
    "locations": [0, 0.45, 1],
    "angle": 180,
    "glows": [
      { "x": 0.62, "y": 0.68, "radius": 0.95, "color": "#0A84FF8C" },
      { "x": 0.92, "y": 0.06, "radius": 0.6, "color": "#3E7BFA4D" },
      { "x": 0.02, "y": 0.98, "radius": 0.7, "color": "#5E5CE666" }
    ],
    "images": [
      { "path": "assets/vault-door.png", "x": 0.5, "y": 0.12, "width": 1.3, "rotation": -6, "opacity": 0.06 }
    ]
  },
  "text": {
    "position": "top",
    "anchor": "edge",
    "title": { "font": "system", "size": 150, "weight": "bold", "color": "#FFFFFF" },
    "subtitle": { "font": "system", "size": 56, "weight": "regular", "color": "#FFFFFFC7" },
    "spacing": 28,
    "minScale": 0.8,
    "maxScale": 1,
    "maxRotation": 0,
    "accentColor": "#4DA3FF"
  },
  "padding": 104,
  "gap": 64,
  "shadow": { "color": "#000000A6", "radius": 90, "offsetY": 36 },
  "screenshots": [
    {
      "output": "iphone-01-codes",
      "title": "Every code.\nEvery secret.",
      "accent": "secret.",
      "subtitle": "Two-factor codes and private notes,\nkept on your iPhone.",
      "devices": [
        { "path": "../.build/screenshots/raw/iphone/01-feed.png", "x": 0.6, "y": 0.78, "width": 1.06, "rotation": -8 }
      ],
      "callouts": [
        {
          "region": { "x": 36, "y": 336, "width": 608, "height": 608 },
          "x": 0.34,
          "y": 0.5,
          "scale": 1.4,
          "rotation": -4,
          "borderWidth": 0,
          "highlight": false,
          "shadow": { "color": "#0A84FFB3", "radius": 110, "offsetY": 0 }
        }
      ]
    },
    {
      "output": "iphone-02",
      "pages": [
        { "title": "Locked with\na password", "subtitle": "Face ID, then an App Lock Password\nthat encrypts the whole vault." },
        { "title": "Forced to\nunlock it?", "subtitle": "A duress password opens a separate\nvault instead of your real one." },
        { "title": "Erase after 10\nwrong passwords", "subtitle": "If you turn it on, 10 wrong passwords\nin a row erase every vault." }
      ],
      "devices": [
        { "path": "../.build/screenshots/raw/iphone/05-lock-dark.png", "x": 0.5, "y": 0.87, "width": 0.86, "rotation": -5 },
        { "path": "../.build/screenshots/raw/iphone/06-app-lock-password.png", "x": 1.56, "y": 0.72, "width": 0.78, "rotation": 5 },
        {
          "path": "../.build/screenshots/raw/iphone/06-app-lock-password-dark.png",
          "x": 2.46,
          "y": 0.74,
          "width": 0.78,
